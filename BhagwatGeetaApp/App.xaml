        <ResourceDictionary>
            <Color x:Key="Primary">#6D4C41</Color>
            <Color x:Key="Accent">#FFA726</Color>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="#3E2723" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
